{
  "info": {
    "_postman_id": "9ababdcc-df77-4e8d-8243-bc1b5859b33f",
    "name": "TH2 - Retry and Safe Fallback",
    "description": "Run the folders in order. Stop only Room Service before folder 02, then start Room Service again before folder 03.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "58556409",
