    {
      "name": "04 - Business error remains immediate: room does not exist",
      "item": [
        {
          "name": "04.1 - Unknown room id returns 404, not fallback 503",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const pad = (number) => String(number).padStart(2, \"0\");",
                  "const toLocalDateTime = (date) => [",
                  "    date.getFullYear(),",
                  "    pad(date.getMonth() + 1),",
                  "    pad(date.getDate())",
                  "].join(\"-\") + \"T\" + [",
                  "    pad(date.getHours()),",
                  "    pad(date.getMinutes()),",
                  "    pad(date.getSeconds())",
                  "].join(\":\");",
                  "",
                  "const start = new Date(Date.now() + 365 * 24 * 60 * 60 * 1000);",
                  "start.setMinutes(0, 0, 0);",
                  "const end = new Date(start.getTime() + 60 * 60 * 1000);",
                  "pm.environment.set(\"unknown_room_start_time\", toLocalDateTime(start));",
                  "pm.environment.set(\"unknown_room_end_time\", toLocalDateTime(end));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "const error = pm.response.json();",
                  "pm.test(\"Unknown room is a business response, not a technical fallback\", function () {",
                  "    pm.expect(error.code).to.eql(\"ROOM_NOT_FOUND\");",
                  "    pm.expect(error.status).to.eql(404);",
                  "});",
                  "",
                  "console.log(\"Verify one RoomClient call log only. A 404 must not be retried.\");"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": {{unknown_room_id}},\n  \"requesterId\": \"RETRY-UNKNOWN-{{retry_run_id}}\",\n  \"requesterName\": \"Postman Retry Test\",\n  \"purpose\": \"Verify 404 is not retried\",\n  \"startTime\": \"{{unknown_room_start_time}}\",\n  \"endTime\": \"{{unknown_room_end_time}}\",\n  \"attendeeCount\": {{attendee_count}}\n}"
            },
            "url": {
              "raw": "{{reservation_base_url}}/api/v1/reservations",
              "host": [
