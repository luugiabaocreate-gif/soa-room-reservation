        {
          "name": "POST - Create Test Room - Expected 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Created room has an id\", function () {\r\n    const body = pm.response.json();\r\n    pm.expect(body.id).to.exist;\r\n});\r\n\r\nconst createdRoom = pm.response.json();\r\n\r\npm.environment.set(\"testRoomId\", createdRoom.id);\r\npm.environment.set(\"testRoomCode\", createdRoom.code);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"code\": \"T{{$timestamp}}\",\r\n  \"building\": \"TEST\",\r\n  \"floor\": 1,\r\n  \"type\": \"THEORY\",\r\n  \"capacity\": 40,\r\n  \"totalComputers\": 0,\r\n  \"workingComputers\": 0,\r\n  \"brokenComputers\": 0,\r\n  \"status\": \"AVAILABLE\"\r\n}",
