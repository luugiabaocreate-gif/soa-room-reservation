# Copy this file to .env only when your services use different URLs.
# v1 is used for create/read-by-id contracts already completed in TH1/TH2.
VITE_ROOM_API_BASE_URL=http://localhost:8080/api/v1
VITE_RESERVATION_API_BASE_URL=http://localhost:8081/api/v1

# v2 is the TH3 query contract: filter, sort and pagination.
VITE_ROOM_QUERY_API_BASE_URL=http://localhost:8080/api/v2
VITE_RESERVATION_QUERY_API_BASE_URL=http://localhost:8081/api/v2
