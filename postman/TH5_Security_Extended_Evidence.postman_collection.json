{
  "info": {
    "name": "SOA Room Reservation — TH5 Extended Security Evidence",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Extended repeatable TH5 evidence: login/JWT, 401/403, Manager Room mutation, Reservation ownership spoof/filter, Student02 isolation. Run manually in item order or in Runner. Audit receipt remains terminal evidence after Reservation 201."
  },
  "variable": [
    {
      "key": "authBaseUrl",
      "value": "http://localhost:8083/api/v1"
    },
    {
      "key": "roomBaseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "roomQueryBaseUrl",
      "value": "http://localhost:8080/api/v2"
    },
    {
      "key": "reservationBaseUrl",
      "value": "http://localhost:8081/api/v1"
    },
    {
      "key": "reservationQueryBaseUrl",
      "value": "http://localhost:8081/api/v2"
    },
    {
      "key": "student01Token",
      "value": ""
    },
    {
      "key": "student02Token",
      "value": ""
    },
    {
      "key": "managerToken",
      "value": ""
    },
    {
      "key": "reservationRoomId",
      "value": "2"
    },
    {
      "key": "managerRoomCode",
      "value": ""
    },
    {
      "key": "spoofStart",
      "value": ""
    },
    {
      "key": "spoofEnd",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Login student01",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"student01\",\n  \"password\": \"DemoPassword123!\"\n}"
        },
        "url": "{{authBaseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.expect(body.tokenType).to.eql('Bearer');",
              "pm.collectionVariables.set('student01Token', body.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login student02",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"student02\",\n  \"password\": \"DemoPassword123!\"\n}"
        },
        "url": "{{authBaseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.collectionVariables.set('student02Token', pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Login room manager",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"roommanager01\",\n  \"password\": \"DemoPassword123!\"\n}"
        },
        "url": "{{authBaseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.collectionVariables.set('managerToken', pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Wrong password is generic 401",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"student01\",\"password\":\"wrong\"}"
        },
        "url": "{{authBaseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 401', function () { pm.response.to.have.status(401); });",
              "pm.expect(pm.response.json().code).to.eql('INVALID_CREDENTIALS');"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Protected Room API without token",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{roomQueryBaseUrl}}/rooms?page=0&size=5&sort=id,asc"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 401', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Student reads rooms",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{student01Token}}"
          }
        ],
        "url": "{{roomQueryBaseUrl}}/rooms?page=0&size=5&sort=id,asc"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Student cannot create Room",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{student01Token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"code\":\"SEC999\",\"building\":\"S\",\"floor\":9,\"type\":\"THEORY\",\"capacity\":10,\"totalComputers\":0,\"workingComputers\":0,\"brokenComputers\":0,\"status\":\"AVAILABLE\"}"
        },
        "url": "{{roomBaseUrl}}/rooms"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 403', function () { pm.response.to.have.status(403); });"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Student create Reservation: spoofed requester is overwritten",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{student01Token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"roomId\": {{reservationRoomId}},\n  \"requesterId\": \"STUDENT-002\",\n  \"requesterName\": \"Spoofed name\",\n  \"purpose\": \"TH5 owner check\",\n  \"startTime\": \"{{spoofStart}}\",\n  \"endTime\": \"{{spoofEnd}}\",\n  \"attendeeCount\": 20\n}"
        },
        "url": "{{reservationBaseUrl}}/reservations"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const start = new Date(Date.now() + 48 * 60 * 60 * 1000);",
              "start.setSeconds(0, 0);",
              "const end = new Date(start.getTime() + 60 * 60 * 1000);",
              "pm.collectionVariables.set('spoofStart', start.toISOString().slice(0, 19));",
              "pm.collectionVariables.set('spoofEnd', end.toISOString().slice(0, 19));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "pm.expect(pm.response.json().requesterId).to.eql('STUDENT-001');"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Student cannot query other owner",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{student01Token}}"
          }
        ],
        "url": "{{reservationQueryBaseUrl}}/reservations?requesterId=STUDENT-002&page=0&size=20&sort=id,asc"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.response.json().content.forEach(function (reservation) { pm.expect(reservation.requesterId).to.eql('STUDENT-001'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Manager creates Room (RBAC allowed)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set('managerRoomCode', 'SEC-' + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{managerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"{{managerRoomCode}}\",\n  \"building\": \"S\",\n  \"floor\": 9,\n  \"type\": \"THEORY\",\n  \"capacity\": 10,\n  \"totalComputers\": 0,\n  \"workingComputers\": 0,\n  \"brokenComputers\": 0,\n  \"status\": \"AVAILABLE\"\n}"
        },
        "url": "{{roomBaseUrl}}/rooms"
      }
    },
    {
      "name": "11 Student02 isolation",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "body.content.forEach(function (reservation) { pm.expect(reservation.requesterId).not.eql('STUDENT-001'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{student02Token}}"
          }
        ],
        "url": "{{reservationQueryBaseUrl}}/reservations?page=0&size=20&sort=id,asc"
      }
    }
  ]
}
