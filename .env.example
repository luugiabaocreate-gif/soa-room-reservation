# Local development values only. Copy to .env, replace both generated secrets,
# then load it into each PowerShell using: . .\scripts\Import-LocalEnv.ps1
# Never commit a real .env file or production credentials.

RABBITMQ_USERNAME=soa
RABBITMQ_PASSWORD=soa-local-dev

ROOM_DB_NAME=room_db
ROOM_DB_USERNAME=room_user
ROOM_DB_PASSWORD=room_local_dev
ROOM_DB_PORT=5433

RESERVATION_DB_NAME=reservation_db
RESERVATION_DB_USERNAME=reservation_user
RESERVATION_DB_PASSWORD=reservation_local_dev
RESERVATION_DB_PORT=5434

AUTH_DB_NAME=auth_db
AUTH_DB_USERNAME=auth_user
AUTH_DB_PASSWORD=auth_local_dev
AUTH_DB_PORT=5435

# Generate a new Base64 32-byte secret for local use. Do not use these placeholders.
JWT_SECRET=REPLACE_WITH_A_BASE64_32_BYTE_SECRET
RESERVATION_SERVICE_CLIENT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SERVICE_SECRET
