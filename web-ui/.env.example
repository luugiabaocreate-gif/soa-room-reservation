# Browser traffic should go through one API Gateway URL. In production this is
# the HTTPS gateway domain; locally it is the TH7 API Gateway on port 8088.
VITE_API_GATEWAY_BASE_URL=http://localhost:8088
VITE_SERVICE_REGISTRY_URL=http://localhost:8761

# Optional direct overrides exist only for isolated diagnostics. Do not put
# secrets here and do not use them for the normal browser deployment.
# VITE_AUTH_API_BASE_URL=https://gateway.example.edu/api/v1
# VITE_ROOM_API_BASE_URL=https://gateway.example.edu/api/v1
# VITE_ROOM_QUERY_API_BASE_URL=https://gateway.example.edu/api/v2
# VITE_RESERVATION_API_BASE_URL=https://gateway.example.edu/api/v1
# VITE_RESERVATION_QUERY_API_BASE_URL=https://gateway.example.edu/api/v2
# VITE_AVAILABILITY_API_BASE_URL=https://gateway.example.edu/api/v3
